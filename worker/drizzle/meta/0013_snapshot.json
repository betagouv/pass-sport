  "views": {
    "public.application_results_by_job_id": {
      "name": "application_results_by_job_id",
      "schema": "public",
      "columns": {
        "email_sent": {
          "name": "email_sent",
          "type": "boolean",
          "primaryKey": false,
          "notNull": true,
          "default": false
        },
        "created_at": {
          "name": "created_at",
          "type": "timestamp with time zone",
          "primaryKey": false,
          "notNull": true,
          "default": "now()"
        }
      },
      "definition": "select \"job_id\" as \"job_id\", \n  case\n    when \"email\" is null then null\n    else left(split_part(\"email\", '@', 1), 1)\n      || '***'\n      || case\n           when length(split_part(\"email\", '@', 1)) > 1\n           then right(split_part(\"email\", '@', 1), 1)\n           else ''\n         end\n      || '@'\n      || split_part(\"email\", '@', 2)\n  end as \"email_mask\", \"email_sent\", \"created_at\" from \"eligibility_results\" where \"eligibility_results\".\"allocataire_fc_sub\" is null\n        and \"eligibility_results\".\"job_id\" is not null\n        and \"eligibility_results\".\"created_at\" = (\n          select max(latest.created_at)\n          from eligibility_results latest\n          where latest.job_id = \"eligibility_results\".\"job_id\"\n        )",
      "materialized": false,
      "isExisting": false
    },
    "public.application_results_by_sub": {
      "name": "application_results_by_sub",
      "schema": "public",
      "columns": {
        "source": {
          "name": "source",
          "type": "text",
          "primaryKey": false,
          "notNull": true
        },
        "verdict": {
          "name": "verdict",
          "type": "text",
          "primaryKey": false,
          "notNull": true
        },
        "pass_sport_code": {
          "name": "pass_sport_code",
          "type": "text",
          "primaryKey": false,
          "notNull": false
        },
        "created_at": {
          "name": "created_at",
          "type": "timestamp with time zone",
          "primaryKey": false,
          "notNull": true,
          "default": "now()"
        }
      },
      "definition": "select \"allocataire_fc_sub\" as \"sub\", \"source\", \"enfant_identite\"->>'given_name' as \"given_name\", \"enfant_identite\"->>'family_name' as \"family_name\", \"enfant_identite\"->>'birthdate' as \"birthdate\", \"enfant_identite\"->>'gender' as \"gender\", \"verdict\", \"pass_sport_code\", \"created_at\" from \"eligibility_results\" where \"eligibility_results\".\"allocataire_fc_sub\" is not null\n        and \"eligibility_results\".\"created_at\" = (\n          select max(latest.created_at)\n          from eligibility_results latest\n          where latest.allocataire_fc_sub = \"eligibility_results\".\"allocataire_fc_sub\"\n        )",
      "materialized": false,
      "isExisting": false
    },
    "public.applications_by_job_id": {
      "name": "applications_by_job_id",
      "schema": "public",
      "columns": {},
      "definition": "select \"job_id\" as \"job_id\", min(\"created_at\") as \"first_application\", max(\"created_at\") as \"last_application\" from \"eligibility_results\" where \"eligibility_results\".\"allocataire_fc_sub\" is null and \"eligibility_results\".\"job_id\" is not null group by \"eligibility_results\".\"job_id\"",
      "materialized": false,
      "isExisting": false
    },
    "public.applications_by_sub": {
      "name": "applications_by_sub",
      "schema": "public",
      "columns": {},
      "definition": "select \"allocataire_fc_sub\" as \"sub\", min(\"created_at\") as \"first_application\", max(\"created_at\") as \"last_application\" from \"eligibility_results\" where \"eligibility_results\".\"allocataire_fc_sub\" is not null group by \"eligibility_results\".\"allocataire_fc_sub\"",
      "materialized": false,
      "isExisting": false
    }
