{
  "name": "pass-sport-worker",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "dev:debug": "tsx watch --inspect=0.0.0.0:9229 src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "tsc --noEmit && vitest run",
    "qf:batch": "tsx src/scripts/qf-batch.ts",
    "redis:decode": "tsx src/scripts/redis-decode.ts"
  },
  "dependencies": {
    "@api-gouv-dinum/api-particulier": "^0.1.1",
    "@sentry/node": "^10.68.0",
    "bullmq": "^5.81.2",
    "csv-parse": "^7.0.1",
    "csv-stringify": "^6.8.1",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.11.1",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.0.4",
    "@testcontainers/redis": "^12.0.4",
    "@types/node": "^20",
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.5",
    "testcontainers": "^12.0.4",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
