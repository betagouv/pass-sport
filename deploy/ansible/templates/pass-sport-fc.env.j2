# Posé par deploy/ansible/traitement.yml — ne pas éditer à la main, les changements seraient
# écrasés au prochain passage du playbook.
#
# Lu par data/2026/partners/franceconnect/run_fc_pipeline.sh (voir son en-tête) : ce que la
# machine seule connaît, et qui n'a rien à faire dans data/.env.
SCALINGO_APP="{{ scalingo_app }}"
SCALINGO_API_TOKEN="{{ scalingo_api_token }}"
FC_PROD_DROP_DIR="{{ fc_prod_drop_dir }}"
{% if scalingo_ssh_identity %}
# db-tunnel monte sa propre connexion SSH, indépendante de SCALINGO_API_TOKEN : sans cette
# variable, elle retombe sur l'agent SSH puis sur ~/.ssh/id_rsa.
SCALINGO_SSH_IDENTITY="{{ scalingo_ssh_identity }}"
{% endif %}
