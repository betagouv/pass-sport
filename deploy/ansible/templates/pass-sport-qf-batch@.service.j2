[Unit]
Description=pass Sport — qf-batch pour %i (quotient familial, API Particulier)
Documentation=file://{{ pass_sport_repo }}/worker/README.md
After=network-online.target
Wants=network-online.target
# 5 échecs en une heure et l'unité renonce : un jeton révoqué ou une entrée illisible ne doit
# pas boucler pendant une semaine en ayant l'air occupé.
StartLimitIntervalSec=1h
StartLimitBurst=5

[Service]
Type=simple
User={{ pass_sport_user }}
Group={{ pass_sport_group }}
# Les CSV de sortie portent des identités pivot : jamais lisibles par tout le monde. 0007
# donne rw-rw---- — le groupe écrit, donc l'autre opérateur peut reprendre le passage, et les
# autres comptes de la machine n'ont rien. Le défaut (0022) les créait en rw-r--r--.
UMask=0007
WorkingDirectory={{ pass_sport_repo }}/worker
ExecStart={{ pass_sport_repo }}/worker/src/scripts/run-qf-batch.sh %i
# Cadencement auto-imposé. Monter d'un palier = changer la variable puis `systemctl restart`.
Environment=QF_RATE={{ pass_sport_qf_rate | default(200) }}
Environment=QF_NIGHT_RATE={{ pass_sport_qf_night_rate | default(500) }}
# Reprise automatique : le script repart des lignes non réglées. 5 min d'attente pour qu'une
# panne passagère d'API ne se transforme pas en martèlement.
Restart=on-failure
RestartSec=5min
# SIGTERM propre : la ligne en cours finit son écriture, le CSV reste un préfixe valide.
KillSignal=SIGTERM
TimeoutStopSec=60
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
