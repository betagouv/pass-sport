
# Force dns resolution to handle upstream ip changes (Scalingo private network IPs can change on restart/scale)
resolver 127.0.0.11 valid=5s ipv6=off;

upstream app_backend {
  server <%= ENV['SCALINGO_PRIVATE_BACKEND_HOSTNAME'] %>:10000 resolve;
  keepalive 16;
  zone app_backend 64k;
}

server {
  server_name localhost;
  listen <%= ENV['PORT'] %>;
  charset utf-8;

  # Common proxy headers/settings, inherited by every location below
  proxy_intercept_errors  on;
  proxy_set_header        Host                 <%= ENV['PUBLIC_FQDN'] %>;
  proxy_set_header        X-Real-IP            $remote_addr;
  proxy_set_header        X-Forwarded-For      $proxy_add_x_forwarded_for;
  proxy_set_header        X-Forwarded-Protocol $scheme;
  
  # Performances improvment
  proxy_http_version 1.1;
  proxy_set_header Connection "";

<% if ENV['ENABLE_MODSECURITY'] == 'true' %>
  modsecurity on;
  modsecurity_rules_file /app/waf_rules.conf;
<% end %>

  location /nous-contacter {
    return 301 https://<%= ENV['PUBLIC_FQDN'] %>/v2/une-question;
  }

  location /decouvrir-le-passsport {
    return 301 https://<%= ENV['PUBLIC_FQDN'] %>/v2/tout-savoir-sur-le-pass-sport;
  }

  location /obtenir-mon-code {
    return 301 https://<%= ENV['PUBLIC_FQDN'] %>/v2/test-ou-code;
  }

  location /jeunes-et-familles/faq {
    return 301 https://<%= ENV['PUBLIC_FQDN'] %>/v2/une-question;
  }

  location /jeunes-et-familles/obtenir-mon-code {
    return 301 https://<%= ENV['PUBLIC_FQDN'] %>/v2/test-ou-code;
  }

  location /structures-daccueil {
    return 301 https://<%= ENV['PUBLIC_FQDN'] %>/v2/trouver-un-club;
  }

  location /faq/passsport-quest-ce-que-cest {
    return 301 https://<%= ENV['PUBLIC_FQDN'] %>/v2/une-question;
  }

  location /ressources-et-relais-dinformations/le-club-de-ton-choix/ {
    return 301 https://<%= ENV['PUBLIC_FQDN'] %>/v2/trouver-un-club;
  }

  location /decouvrir-le-passsport/ {
    return 301 https://<%= ENV['PUBLIC_FQDN'] %>/v2/jeunes-et-parents;
  }

  location /clubs-et-structures-daccueil/le-passport-pour-les-clubs {
    return 301 https://<%= ENV['PUBLIC_FQDN'] %>/v2/structures;
  }

  location /clubs-et-structures-daccueil/comment-me-faire-rembourser-des-deductions-passsport-consenties {
    return 301 https://<%= ENV['PUBLIC_FQDN'] %>/v2/structures;
  }

  location /clubs-et-structures-daccueil/les-outils-de-communication-a-destination-des-clubs {
    return 301 https://<%= ENV['PUBLIC_FQDN'] %>/v2/partenaires;
  }

  location /le-passsport-reconduit-pour-la-saison-2023-2024 {
    return 301 https://<%= ENV['PUBLIC_FQDN'] %>/v2/accueil;
  }

  location /v2/test-eligibilite-mai {
    return 301 https://<%= ENV['PUBLIC_FQDN'] %>/v2/test-eligibilite-base;
  }

  location = /v2/une-question {
    proxy_pass http://app_backend;
    limit_req zone=faq_req_limit burst=60 nodelay;
  }

  location /v2/ {
    proxy_pass http://app_backend;
    # Next.js prefetches the RSC payload of every visible link on a page as its own
    # parallel request, so a single page view can burst well past the old burst=30
    # before the visitor clicks anything. Sized to absorb that fan-out.
    limit_req zone=next_v2_nav_req_limit burst=150 nodelay;
  }

  location = /api/france-connect/result {
    proxy_pass http://app_backend;
    limit_req zone=api_poll_limit burst=10 nodelay;
  }

  location = /api/eligibility-test/verdict {
    proxy_pass http://app_backend;
    limit_req zone=eligibility_req_limit burst=5 nodelay;
  }

  location /api/ {
    proxy_pass http://app_backend;
    limit_req zone=api_req_limit burst=10 nodelay;
  }

  location /_next {
    proxy_pass http://app_backend/_next;
    access_log off;
  }

  location /images {
    proxy_pass http://app_backend/images;
    access_log off;
  }

  location /assets {
    proxy_pass http://app_backend/assets;
    access_log off;
  }

  location / {
    proxy_pass http://app_backend;
    proxy_redirect off;
  }

}

# # 503 is indistinguishable from a real outage, both for the browser and for monitoring.
limit_req_status    429;
# limit_req_log_level error;

# Trusted upstream ranges exempted from rate limiting: an empty $limit_req_key makes
# nginx skip limiting entirely for the matching request (documented limit_req_zone behavior).
geo $limit_req_key {
  default              $http_x_real_ip;
  185.24.186.224/28    "";
  82.210.16.160/28     "";
  145.242.17.29/32     "";
}

# 10m holds ~160k client states at 64 bytes each, well beyond this traffic.
limit_req_zone $limit_req_key zone=api_poll_limit:10m         rate=20r/m;
limit_req_zone $limit_req_key zone=api_req_limit:10m          rate=20r/m;
limit_req_zone $limit_req_key zone=eligibility_req_limit:10m  rate=20r/m;
limit_req_zone $limit_req_key zone=next_v2_nav_req_limit:100m rate=300r/m;
limit_req_zone $limit_req_key zone=faq_req_limit:10m           rate=600r/m;