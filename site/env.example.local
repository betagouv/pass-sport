# POC FranceConnect + API Particulier
FRANCE_CONNECT_CLIENT_ID=""
FRANCE_CONNECT_CLIENT_SECRET=""
FRANCE_CONNECT_BASE_URL="https://fcp-low.sbx.dev-franceconnect.fr/api/v2"
# Optional fine-grained endpoint overrides (otherwise derived from FRANCE_CONNECT_BASE_URL).
#FRANCE_CONNECT_AUTHORIZATION_ENDPOINT=""
#FRANCE_CONNECT_TOKEN_ENDPOINT=""
#FRANCE_CONNECT_USERINFO_ENDPOINT=""
#FRANCE_CONNECT_END_SESSION_ENDPOINT=""
# JWKS used to verify id_token / userinfo ES256 signatures (derived from BASE_URL if unset).
#FRANCE_CONNECT_JWKS_ENDPOINT=""
# Expected token issuer (defaults to FRANCE_CONNECT_BASE_URL).
#FRANCE_CONNECT_ISSUER=""
#FRANCE_CONNECT_SCOPES=""
# Must exactly match the redirect URI registered with FranceConnect.
FRANCE_CONNECT_REDIRECT_URI="http://localhost:3000/v2/api/poc-fc-api-particulier/callback"
FRANCE_CONNECT_POST_LOGOUT_REDIRECT_URI="http://localhost:3000/v2/api/poc-fc-api-particulier/logout/callback"

# API Particulier v3 (@api-gouv-dinum/api-particulier SDK)
# Static token, used by the mode 1 form fallback ("identité" endpoints).
# The FranceConnect flow (mode 2) authenticates with the FC access token instead.
API_PARTICULIER_TOKEN=""
API_PARTICULIER_ENV="staging"
# SIRET of your administration (recipient). Mandatory in v3: traceability of the
# public entity on whose behalf the call is made.
API_PARTICULIER_RECIPIENT_SIRET="13002526500013"
# Distributed token-bucket rate limiter (hard upstream limit: 20 req/s).
# Redis stores only counters — provided by the Scalingo Redis addon.
REDIS_URL=""
API_PARTICULIER_RATE="18"
API_PARTICULIER_BUCKET_CAPACITY="18"
API_PARTICULIER_MAX_WAIT_MS="2500"

LINK_MOBILITY_API_KEY=""
LINK_MOBILITY_SENDER_EMAIL=""
LINK_MOBILITY_SENDER_NAME=""
LINK_MOBILITY_API_URL=""


