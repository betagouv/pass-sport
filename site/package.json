{
  "name": "pass-sport-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^25"
  },
  "scripts": {
    "predev": "react-dsfr update-icons",
    "prebuild": "react-dsfr update-icons",
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "scalingo-cleanup": "bash ./scripts/scalingo-cleanup.sh",
    "start": "next start",
    "lint": "eslint --ignore-pattern=scripts/**/*",
    "format:check": "prettier --check --ignore-path .gitignore \"**/*.+(ts|tsx|json|mjs|scss)\"",
    "format:write": "npm run format:check -- --write",
    "test": "jest --runInBand",
    "test:ct": "playwright test -c playwright-ct.config.ts",
    "docker:run:dev": "docker-compose -f ../compose.yml down && docker-compose -f ../compose.yml up",
    "scripts:send-in-mass": "node -r dotenv/config ./scripts/send-in-mass.mjs dotenv_config_path=./.env.local",
    "scripts:send-in-mass-march-2025": "node -r dotenv/config ./scripts/send-in-mass-march-2025.mjs dotenv_config_path=./.env.local",
    "scripts:send-in-mass-code-pas-recu": "node -r dotenv/config ./scripts/send-in-mass-code-pas-recu.mjs.mjs dotenv_config_path=./.env.local",
    "scripts:send-in-mass-aeeh": "node -r dotenv/config ./scripts/send-in-mass-aeeh.mjs dotenv_config_path=./.env.local",
    "scripts:send-in-mass-eligibility-test-fail": "node -r dotenv/config ./scripts/send-in-mass-eligibility-test-fail.mjs dotenv_config_path=./.env.local",
    "scripts:unresolve-boursiers": "node -r dotenv/config ./scripts/unresolve-boursiers.mjs dotenv_config_path=./.env.local"
  },
  "dependencies": {
    "@codegouvfr/react-dsfr": "^1.33.0",
    "@react-pdf/renderer": "^4.9.0",
    "@sentry/nextjs": "^10.71.0",
    "@socialgouv/matomo-next": "1.9.2",
    "@uidotdev/usehooks": "^2.4.1",
    "bullmq": "^5.81.4",
    "classnames": "^2.5.1",
    "crisp-api": "^10.11.0",
    "date-fns": "^4.4.0",
    "geolib": "^3.3.14",
    "got": "^15.1.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.10",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "next": "^16.3.3",
    "node-cache": "^5.1.2",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "react-select": "^5.10.2",
    "remark-breaks": "^4.0.0",
    "zod": "^4.4.3",
    "zod-form-data": "^3.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/experimental-ct-react": "^1.62.1",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jest": "^30.5.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.9.6",
    "sass": "^1.103.1",
    "typescript": "^5.9.3",
    "webpack": "^5.110.1"
  },
  "packageManager": "pnpm@11.4.0"
}
