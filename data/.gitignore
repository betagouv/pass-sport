# Celles-ci sont du code, pas des données : ce sont les requêtes d'extraction, de
# rapprochement, de write-back et de contrôle de la source franceconnect. Le *.sql ci-dessus
# vise les dumps de base. Toute requête ajoutée à ce dossier doit être listée ici, sans quoi
# elle reste invisible pour git.
!2026/partners/franceconnect/export_eligible_pending.sql
!2026/partners/franceconnect/match_beneficiaires.sql
!2026/partners/franceconnect/writeback_verdict.sql
!2026/partners/franceconnect/writeback_confirmed.sql
!2026/partners/franceconnect/check_writeback.sql
!2026/partners/franceconnect/check_confirmed.sql
!2026/dashboard/load_dashboard.sql
!2026/grist-dn-pipeline/match_grist_dn.sql
!2026/partners/v_pays_territoire_2026.csv

ignored/
backup/
statiscs/*.pdf
__pycache__

*.log
logs/

# Un dossier par passage de run_fc_pipeline.sh : CSV nominatifs et journaux.
2026/partners/franceconnect/run/
# Same for run_aah_direct.sh.
2026/support-pipeline/run/
# Same for run_grist_dn.sh, raw API answers included.
2026/grist-dn-pipeline/run/
# Same for run_cnous_boursiers.sh, the executed notebook included.
2026/partners/cnous/run/

# One directory per run_dashboard.sh run: logs only.
2026/dashboard/run/
